{
  "name": "dtc-management-system",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "client",
    "server",
    "workstation-client"
  ],
  "scripts": {
    "install:all": "npm install --workspaces",
    "dev": "npm run dev -w server",
    "dev:client": "npm run dev -w client",
    "dev:server": "npm run dev -w server",
    "dev:workstation": "npm run dev -w workstation-client",
    "build": "npm run build -w client && npm run build -w workstation-client && npm run build -w server",
    "seed": "npm run seed -w server",
    "lint": "npm run lint -w client && npm run lint -w server && npm run lint -w workstation-client"
  },
  "engines": {
    "node": ">=20.11.0",
    "npm": ">=10.0.0"
  }
}
